{
  "name": "ibl-sis",
  "version": "0.1.0",
  "private": true,
  "description": "ibl.ai/sis — the open-source student information system for schools on the ibl.ai platform",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--no-experimental-webstorage\" next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "lint": "oxlint --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test --config e2e/playwright.config.ts --ui",
    "test:e2e:headed": "cross-env HEADED=true playwright test --config e2e/playwright.config.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:watch": "vitest",
    "probe:lms": "node scripts/probe-lms.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "i18n:check": "node scripts/validate-i18n.mjs",
    "release": "release-it"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@iblai/iblai-js": "2.33.2",
    "@livekit/components-react": "^2.9.24",
    "@reduxjs/toolkit": "^2.13.0",
    "@tauri-apps/plugin-os": "^2.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "livekit-client": "^2.22.3",
    "lucide-react": "^1.54.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "^9.2.0",
    "recharts": "^2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.3",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.6",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "release-it": "^21.1.1",
    "shadcn": "^4.21.4",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.1"
}
