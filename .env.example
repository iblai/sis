# ibl.ai/sis — copy to .env.local (gitignored). Everything is optional against
# hosted iblai.app; the defaults live in lib/iblai/config.ts.

# Self-hosted platform: the consolidated API origin (/dm, /lms, /studio, /axd are derived)
# NEXT_PUBLIC_API_BASE_URL=https://api.iblai.app
# NEXT_PUBLIC_AUTH_URL=https://login.iblai.app
# NEXT_PUBLIC_PLATFORM_BASE_DOMAIN=iblai.app

# The Open edX micro-frontends (the embedded gradebook).
# NEXT_PUBLIC_MFE_URL=https://apps.learn.iblai.app

# The community platform — the one platform the app never works in.
NEXT_PUBLIC_MAIN_TENANT_KEY=main

# `app=` sent to the Auth SPA (the OS's value; every platform can sign in).
# NEXT_PUBLIC_IBL_PLATFORM=mentor

# Links out to the Agentic OS.
# NEXT_PUBLIC_OS_URL=https://os.ibl.ai

# NEXT_PUBLIC_ENABLE_RBAC=false
# NEXT_PUBLIC_SUPPORT_EMAIL=support@ibl.ai
