# Playwright E2E configuration — the gitignored copy is e2e/.env.development.
# `pnpm e2e:accounts` creates a platform admin and a student in the THROWAWAY
# platform iblai.env names (never the community platform) and fills in the four
# PLAYWRIGHT_* values (the *_USERNAME values are emails). auth.setup.ts needs
# the admin pair; without the student pair the member journey (M*) skips. The
# journeys write to that platform and undo what they can; an invitation, an
# imported account, a course run and learning-platform tasks stay behind.
APP_HOST=http://localhost:3000
AUTH_HOST=https://login.iblai.app
PLAYWRIGHT_USERNAME=
PLAYWRIGHT_PASSWORD=
PLAYWRIGHT_MEMBER_USERNAME=
PLAYWRIGHT_MEMBER_PASSWORD=
