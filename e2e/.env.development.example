# Playwright E2E configuration — copy to e2e/.env.development (gitignored)
# and fill in real credentials. auth.setup.ts refuses to run without them.
# The account must administer a THROWAWAY platform: the journeys write terms,
# groups and a record field there. Never the community platform.
APP_HOST=http://localhost:3000
AUTH_HOST=https://login.iblai.app
PLAYWRIGHT_USERNAME=your-username
PLAYWRIGHT_PASSWORD=your-password
